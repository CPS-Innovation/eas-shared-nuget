<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="GitLab" value="https://gitlab.com/api/v4/projects/69797752/packages/nuget/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="GitLab">
      <package pattern="Cps.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
