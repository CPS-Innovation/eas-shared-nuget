<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

	  <!-- NuGet metadata -->
	  <PackageId>EasShared</PackageId>
	  <Version>1.0.0</Version>
	  <Authors>Faisal Shehzad</Authors>
	  <Company>CPS</Company>
	  <Description>Reusable components for Email Automation microservices</Description>
	  <PackageTags>internal;utility;shared</PackageTags>

	  <!-- Required to generate .nupkg -->
	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	  <IncludeSymbols>true</IncludeSymbols>
	  <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Core\Core.csproj" />
    <None Include="ServiceClient\GraphApi\ServiceClient.GraphApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="9.0.7" />
    <PackageReference Include="Microsoft.Graph" Version="5.85.0" />
    <PackageReference Include="Microsoft.VisualStudio.Validation" Version="17.8.8" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ServiceClient\GraphApi\bin\Release\net7.0\" />
    <Folder Include="ServiceClient\GraphApi\obj\Release\net7.0\refint\" />
    <Folder Include="ServiceClient\GraphApi\obj\Release\net7.0\ref\" />
  </ItemGroup>

</Project>
