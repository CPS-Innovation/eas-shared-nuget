<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

	  <!-- NuGet metadata -->
	  <PackageId>EasShared</PackageId>
	  <Version>1.0.0</Version>
	  <Authors>Faisal Shehzad</Authors>
	  <Company>CPS</Company>
	  <Description>Reusable components for Email Automation microservices</Description>
	  <PackageTags>internal;utility;shared</PackageTags>

	  <!-- Required to generate .nupkg -->
	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	  <IncludeSymbols>true</IncludeSymbols>
	  <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
