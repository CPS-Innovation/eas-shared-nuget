<Project>

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup Label="AWS">
		<PackageVersion Include="AWSSDK.CloudWatchLogs" Version="4.0.104.3" />
		<PackageVersion Include="AWSSDK.Core" Version="4.0.102.6" />
		<PackageVersion Include="AWSSDK.S3" Version="4.0.103.3" />
	</ItemGroup>

	<ItemGroup Label="Microsoft Graph and Kiota">
		<PackageVersion Include="Azure.Identity" Version="1.21.0" />
		<PackageVersion Include="Microsoft.Graph" Version="6.6.0" />
		<PackageVersion Include="Microsoft.Kiota.Abstractions" Version="2.1.2" />
		<PackageVersion Include="Microsoft.Kiota.Serialization.Json" Version="2.1.2" />
	</ItemGroup>

	<ItemGroup Label="Microsoft.Extensions">
		<PackageVersion Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup Label="Messaging">
		<PackageVersion Include="CloudNative.CloudEvents" Version="2.9.0" />
		<PackageVersion Include="CloudNative.CloudEvents.SystemTextJson" Version="2.9.0" />
		<PackageVersion Include="Polly" Version="8.8.0" />
		<!-- Frozen: v7 is a full async rewrite (IModel becomes IChannel). Separate epic. -->
		<PackageVersion Include="RabbitMQ.Client" Version="6.8.1" />
	</ItemGroup>

	<ItemGroup Label="Email formats">
		<PackageVersion Include="MsgKit" Version="3.0.5" />
		<PackageVersion Include="MsgReader" Version="6.1.2" />
	</ItemGroup>

	<ItemGroup Label="Analysis">
		<PackageVersion Include="Microsoft.VisualStudio.Validation" Version="17.13.22" />
		<PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
	</ItemGroup>

	<ItemGroup Label="Test">
		<PackageVersion Include="coverlet.collector" Version="10.0.1" />
		<!-- Frozen: v8 requires a paid commercial licence; v7 is the last freely licensed major. -->
		<PackageVersion Include="FluentAssertions" Version="6.12.0" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
		<PackageVersion Include="Moq" Version="4.20.72" />
		<PackageVersion Include="xunit" Version="2.8.1" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="2.8.1" />
	</ItemGroup>

</Project>
