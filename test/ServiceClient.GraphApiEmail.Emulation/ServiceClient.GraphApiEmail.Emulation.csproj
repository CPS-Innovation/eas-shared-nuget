<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Cps.Fct.EasShared.$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>$(RootNamespace)</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Embedded\Sample.MIME.attachment.content.eml" />
    <None Remove="Embedded\Sample.MIME.content.eml" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Analysis\stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Embedded\Email.template.json" />
    <EmbeddedResource Include="Embedded\Pdf.attachment.pdf" />
    <EmbeddedResource Include="Embedded\Sample.MIME.attachment.content.eml" />
    <EmbeddedResource Include="Embedded\Sample.MIME.content.eml" />
    <EmbeddedResource Include="Embedded\Text.attachment.txt" />
    <EmbeddedResource Include="Embedded\Sample.email.body.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Validation" />
    <PackageReference Include="Moq" />
    <PackageReference Include="StyleCop.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Core.csproj" />
    <ProjectReference Include="..\..\src\ServiceClient.GraphApiEmail\ServiceClient.GraphApiEmail.csproj" />
  </ItemGroup>

</Project>
