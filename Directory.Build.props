<Project>

	<!-- Pin MimeKit to non-vulnerable version (transitive via MsgKit in ServiceClient.GraphApiEmail) -->
	<ItemGroup Condition="'$(MSBuildProjectName)' == 'ServiceClient.GraphApiEmail'">
		<PackageReference Include="MimeKit" Version="4.15.1" />
	</ItemGroup>

	<!-- Align System.Text.Json across all projects with the Azure.Core 1.53.0 floor.
     Closes GHSA-hh2w-p6rv-4g7w / GHSA-8g4q-xg66-9fp4 (vulnerable in 8.0.0). -->
	<ItemGroup>
		<PackageReference Include="System.Text.Json" Version="10.0.3" />
	</ItemGroup>
</Project>